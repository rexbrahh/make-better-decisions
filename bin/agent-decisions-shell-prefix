#!/bin/sh
# Run `agent-decisions shell-prefix`. A runtime bundle holds the binary beside this file. A plugin root does not, so
# use the binary of the active runtime that bin/agent-decisions-install published.
binary="${0%/*}/agent-decisions"
[ -x "$binary" ] || binary="$HOME/.local/share/agent-decisions/current/bin/agent-decisions"
exec "$binary" shell-prefix "$@"
